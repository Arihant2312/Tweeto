<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>All Users' Posts</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen bg-zinc-900 text-white">
    <div class="container mx-auto py-8">
        <h2 class="text-3xl font-bold mb-6">All Users' Posts</h2>
 </div>
        <div class="flex flex-wrap gap-6">
            <% posts.forEach(function(post){ %>
            <div class="post w-full md:w-1/4 p-5 border-2 border-zinc-800 bg-zinc-900 rounded-lg shadow-lg">
                <h4 class="text-teal-400 text-xl font-semibold">@<%= post.user?.username || "Unknown" %></h4>
                <p class="mt-2 text-zinc-400">"<%= post.content %>"</p>
                <span class="text-yellow-400">👍 <%= post.likes.length %></span>
            </div>
            <% }) %>
        </div>
        <a href="/profile" class="mt-8 inline-block text-teal-400 hover:underline">&larr; Back to Profile</a>
    </div>
</body>
</html>